{
  "name": "postal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:city": "node scripts/fetch-city-overpass.mjs",
    "cap:sync": "VITE_DATA_BASE=https://franziskus16.github.io/postal/data/ npm run build && npx cap sync",
    "data:spain": "bash scripts/build-data.sh es",
    "data:portugal": "bash scripts/build-data.sh pt",
    "data:all": "npm run data:spain && npm run data:portugal"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "maplibre-gl": "^6.18.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/geojson": "^7946.0.16",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
